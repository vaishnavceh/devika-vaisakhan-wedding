# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Render / Local)
# ==========================================
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed origins, or * for all in dev
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Authoritative Google Maps URLs
TEMPLE_MAP_URL=https://share.google/JoWJRWtprleSe488s
RESIDENCE_MAP_URL=https://maps.app.goo.gl/tk4SToeGGwNHcAUZ7?g_st=aw

# Bride-Side Contact Numbers (Configurable)
BRIDE_CONTACT_1=9605941066
BRIDE_CONTACT_2=9526516107

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel / Local)
# ==========================================
# Leave empty for same-origin dev proxy, or provide full Render API URL in production
VITE_API_BASE_URL=
VITE_TEMPLE_MAP_URL=https://share.google/JoWJRWtprleSe488s
VITE_RESIDENCE_MAP_URL=https://maps.app.goo.gl/tk4SToeGGwNHcAUZ7?g_st=aw
VITE_BRIDE_CONTACT_1=9605941066
VITE_BRIDE_CONTACT_2=9526516107

# ==========================================
# DOCKER COMPOSE PORTS
# ==========================================
FRONTEND_PORT=3000
BACKEND_PORT=5000
